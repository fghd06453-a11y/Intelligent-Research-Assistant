# ============================================================
# 智能研究系统 — 环境配置模板
# 复制为 .env 并填写真实值
# ============================================================

# --- API 密钥（必填，替换为你的真实 Key）---
DASHSCOPE_API_KEY=你的阿里云百炼Key
BOCHA_API_KEY=你的博查搜索Key

# --- 模型（可选）---
MODEL=qwen-plus

# --- Redis（已注释不用，如需启用去掉注释）---
REDIS_URL=redis://:Yoxxxxxx@127.0.0.1:6379

# --- PostgreSQL ---
POSTGRES_DSN=postgresql://root:Yxxxxxx@127.0.0.1:5432/mydb

# --- Milvus ---
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory

# --- 记忆系统 ---
ENABLE_MEMORY=true
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
CHECKPOINTER_BACKEND=postgres
ENABLE_MILVUS=true
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SAVE_CONVERSATION_TASK=false
MEMORY_TOP_K=6

# --- 用户标识 ---
TENANT_ID=default_tenant
USER_ID=default_user
THREAD_ID=default
MAX_ITERATIONS=3

# --- 工作区 ---
WORKSPACE_DIR=/workspace
NO_COLOR=
